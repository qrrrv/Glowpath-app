def cleanup_text(value):
    if value is None:
        return ""
    text = " ".join(str(value).replace("\n", " ").split()).strip()
    if len(text) > 220:
        return text[:219] + "…"
    return text


def safe_int(value, default=0):
    try:
        return int(value)
    except Exception:
        return default


def clamp(value, low, high):
    return max(low, min(high, value))


def format_ms(value):
    total = max(0, safe_int(value))
    seconds = total // 1000
    minutes = seconds // 60
    hours = minutes // 60
    if hours > 0:
        return f"{hours}:{minutes % 60:02d}:{seconds % 60:02d}"
    return f"{minutes}:{seconds % 60:02d}"


def blend_color(a, b, t):
    t = float(t)
    return tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))


def with_alpha(rgb, alpha):
    return (rgb[0], rgb[1], rgb[2], alpha)


def has_unicode_text(text):
    for char in cleanup_text(text):
        if ord(char) > 127:
            return True
    return False


class Plugin(BasePlugin):
    def on_plugin_load(self):
        self.add_on_send_message_hook()
        self._run_migrations()
        self.add_menu_item(
            MenuItemData(
                menu_type=MenuItemType.CHAT_ACTION_MENU,
                text="Поделиться настройками Now Card",
                icon="msg_share",
                priority=90,
                on_click=self._share_preset_from_chat_menu,
            )
        )
        self.add_menu_item(
            MenuItemData(
                menu_type=MenuItemType.MESSAGE_CONTEXT_MENU,
                text="Применить конфиг Now Card",
                icon="msg_download",
                priority=90,
                on_click=self._import_preset_from_message_menu,
            )
        )
        self.log("Now Card loaded")

