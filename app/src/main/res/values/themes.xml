<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Главная тема приложения (Material 3) -->
    <style name="Theme.MusicPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Прозрачный статус и нав-бар — цвет управляется из Compose через SideEffect -->
        <item name="android:windowBackground">#0A040C</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="dynamicColorThemeOverlay">@style/ThemeOverlay.Material3.DynamicColors.DayNight</item>
    </style>
</resources>
